<Project>
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<Version>10.0.16-dev</Version>
		<NoWarn>$(NoWarn);CS1591;CS0436;IDE0028;IDE0130;IDE0290;IDE0305</NoWarn>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<OutputPath>..\bin</OutputPath>
		<DocumentationFile>..\bin\$(MSBuildProjectName).xml</DocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		
		<RepositoryUrl>https://github.com/dotnetcore-group/BeniceSoft.Abp</RepositoryUrl>

		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Content Remove="*.abppkg.json"/>
		<None Include="*.abppkg.json">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</None>
	</ItemGroup>

</Project>
