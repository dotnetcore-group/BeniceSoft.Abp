<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ABP Framework -->
    <PackageVersion Include="Volo.Abp.AspNetCore" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.AspNetCore.MultiTenancy" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.AspNetCore.Mvc" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Authorization" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Autofac" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Caching" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Caching.StackExchangeRedis" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Core" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Ddd.Application" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Ddd.Application.Contracts" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Ddd.Domain" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.EntityFrameworkCore" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.EntityFrameworkCore.PostgreSql" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.EntityFrameworkCore.SqlServer" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.EntityFrameworkCore.Sqlite" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageVersion Include="Volo.Abp.EventBus" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.EventBus.RabbitMQ" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.RabbitMQ" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Http.Client" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Http.Client.Dapr" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.MailKit" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.MultiTenancy" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Security" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.TestBase" Version="10.6.0" />
    <!-- Microsoft Identity Model -->
    <!--
      统一 Microsoft.IdentityModel 包版本
      原因：OpenIddict.Abstractions 依赖较高版本的 IdentityModel，
           与 Microsoft.AspNetCore.Authentication.JwtBearer 传递依赖可能不一致。
      在此处统一版本，避免业务项目需要单独处理版本冲突
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.21.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.21.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Logging" Version="8.21.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="8.21.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.21.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.21.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.301" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.21.0" />
    <!-- Microsoft Extensions & EF Core -->
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.PlatformAbstractions" Version="1.1.0" />
    <!-- OpenIddict -->
    <PackageVersion Include="OpenIddict.Abstractions" Version="7.6.0" />
    <!-- Data & Caching -->
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="StackExchange.Redis" Version="2.13.17" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.1.2" />
    <PackageVersion Include="SqlKata" Version="4.0.1" />
    <!-- Web & API -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageVersion Include="Mapster" Version="10.0.11" />
    <PackageVersion Include="SmartFormat" Version="3.6.1" />
    <!-- Infrastructure -->
    <PackageVersion Include="AgileConfig.Client" Version="1.8.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
    <PackageVersion Include="Wecharmer.AM.Sdk" Version="1.0.3-dev" />
    <PackageVersion Include="Wecharmer.PermissionCenter.Sdk" Version="1.0.1-dev" />
    <PackageVersion Include="Wecharmer.WorkflowCenter.Sdk" Version="0.0.1-dev" />
    <PackageVersion Include="Winton.Extensions.Configuration.Consul" Version="3.4.0" />
    <!--dtm-->
    <PackageVersion Include="DtmCommon" Version="1.4.0" />
    <PackageVersion Include="Dtmcli" Version="1.4.0" />
    <PackageVersion Include="Dtmgrpc" Version="1.4.0" />
    <!-- WorkflowCore -->
    <PackageVersion Include="WorkflowCore" Version="3.18.0" />
    <!-- Office -->
    <PackageVersion Include="NPOI" Version="2.7.3" />
    <PackageVersion Include="PdfPig" Version="0.1.15" />
    <PackageVersion Include="PDFtoImage" Version="5.3.0" />
    <PackageVersion Include="PdfSharpCore" Version="1.3.67" />
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <PackageVersion Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.22" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.61" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>
</Project>