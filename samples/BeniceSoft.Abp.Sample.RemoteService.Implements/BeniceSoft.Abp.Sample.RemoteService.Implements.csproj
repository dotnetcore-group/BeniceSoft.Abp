  <ItemGroup>
    <ProjectReference Include="..\..\src\BeniceSoft.Abp.Core\BeniceSoft.Abp.Core.csproj" />
    <ProjectReference Include="..\..\src\BeniceSoft.Abp.Http.Client\BeniceSoft.Abp.Http.Client.csproj" />
